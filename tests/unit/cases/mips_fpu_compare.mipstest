# Ordered less-than comparison updates fpcond and the FCR31 condition bit.
address 0x08800000
initial a0 0x3F800000
initial a1 0x40000000
mips_word 0x44840000  # mtc1 a0, f0 (1.0)
mips_word 0x44850800  # mtc1 a1, f1 (2.0)
mips_word 0x46010034  # c.olt.s f0, f1
mips_word 0x4442F800  # cfc1 v0, fcr31
mips_word 0x0A200006  # j 0x08800018
mips_word 0x00000000  # delay-slot nop

expect v0 0x00800000
expect_pc 0x08800018
