# PPSSPP/MIPS-defined division-by-zero and signed-overflow behavior.
address 0x08800000
mips_word 0x2408FFFB  # addiu t0, zero, -5
mips_word 0x0100001A  # div t0, zero
mips_word 0x00001012  # mflo v0
mips_word 0x00001810  # mfhi v1
mips_word 0x3C098000  # lui t1, 0x8000 (INT_MIN)
mips_word 0x240AFFFF  # addiu t2, zero, -1
mips_word 0x012A001A  # div t1, t2
mips_word 0x00002012  # mflo a0
mips_word 0x00002810  # mfhi a1
mips_word 0x240B000A  # addiu t3, zero, 10
mips_word 0x0160001B  # divu t3, zero
mips_word 0x00003012  # mflo a2
mips_word 0x00003810  # mfhi a3
mips_word 0x0A20000F  # j 0x0880003C
mips_word 0x00000000  # delay-slot nop

expect v0 1
expect v1 0xFFFFFFFB
expect a0 0x80000000
expect a1 0xFFFFFFFF
expect a2 0x0000FFFF
expect a3 10
expect_pc 0x0880003C
