# Bit-exact scalar FPU sign operations, including NaN payload and negative zero.
address 0x08800000
initial a0 0xFFC12345
initial a1 0x80000000
mips_word 0x44840000  # mtc1 a0, f0
mips_word 0x44850800  # mtc1 a1, f1
mips_word 0x46000085  # abs.s f2, f0
mips_word 0x460008C7  # neg.s f3, f1
mips_word 0x44021000  # mfc1 v0, f2
mips_word 0x44031800  # mfc1 v1, f3
mips_word 0x0A200008  # j 0x08800020
mips_word 0x00000000  # delay-slot nop

expect v0 0x7FC12345
expect v1 0x00000000
expect f2 0x7FC12345
expect f3 0x00000000
expect_pc 0x08800020
