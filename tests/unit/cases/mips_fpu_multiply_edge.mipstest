# PPSSPP canonicalizes zero multiplied by infinity to this exact quiet NaN.
address 0x08800000
initial a0 0x00000000
initial a1 0xFF800000
mips_word 0x44840000  # mtc1 a0, f0 (+0)
mips_word 0x44850800  # mtc1 a1, f1 (-infinity)
mips_word 0x46010082  # mul.s f2, f0, f1
mips_word 0x44021000  # mfc1 v0, f2
mips_word 0x0A200006  # j 0x08800018
mips_word 0x00000000  # delay-slot nop

expect v0 0x7FC00000
expect f2 0x7FC00000
expect_pc 0x08800018
