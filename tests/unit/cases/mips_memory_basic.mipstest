# Aligned 32-bit RAM store followed by load.
address 0x08800000
mips_word 0x3C080880  # lui t0, 0x0880
mips_word 0x25081000  # addiu t0, t0, 0x1000
mips_word 0x2409002A  # addiu t1, zero, 42
mips_word 0xAD090000  # sw t1, 0(t0)
mips_word 0x8D020000  # lw v0, 0(t0)
mips_word 0x0A200007  # j 0x0880001C
mips_word 0x00000000  # delay-slot nop

expect v0 42
expect_memory 0x08801000 42
expect_pc 0x0880001C
