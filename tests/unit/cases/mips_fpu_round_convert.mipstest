# Explicit rounding operations plus signed integer-to-float conversion.
address 0x08800000
initial a0 0x3FC00000
initial a1 0xBFC00000
initial a2 0xFFFFFFFD
mips_word 0x44840000  # mtc1 a0, f0 (1.5)
mips_word 0x44850800  # mtc1 a1, f1 (-1.5)
mips_word 0x44863000  # mtc1 a2, f6 (-3 as integer bits)
mips_word 0x4600008C  # round.w.s f2, f0 (2)
mips_word 0x460008CD  # trunc.w.s f3, f1 (-1)
mips_word 0x4600090E  # ceil.w.s f4, f1 (-1)
mips_word 0x4600094F  # floor.w.s f5, f1 (-2)
mips_word 0x468031E0  # cvt.s.w f7, f6 (-3.0)
mips_word 0x44021000  # mfc1 v0, f2
mips_word 0x44031800  # mfc1 v1, f3
mips_word 0x44082000  # mfc1 t0, f4
mips_word 0x44092800  # mfc1 t1, f5
mips_word 0x440A3800  # mfc1 t2, f7
mips_word 0x0A20000F  # j 0x0880003C
mips_word 0x00000000  # delay-slot nop

expect v0 0x00000002
expect v1 0xFFFFFFFF
expect t0 0xFFFFFFFF
expect t1 0xFFFFFFFE
expect t2 0xC0400000
expect_pc 0x0880003C
