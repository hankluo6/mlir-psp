# Compare unequal floats and take BC1F, including its delay slot.
address 0x08800000
initial a0 0x3F800000
initial a1 0x40000000
mips_word 0x44840000  # mtc1 a0, f0 (1.0)
mips_word 0x44850800  # mtc1 a1, f1 (2.0)
mips_word 0x46010032  # c.eq.s f0, f1
mips_word 0x45000002  # bc1f 0x08800018
mips_word 0x24020007  # delay slot: addiu v0, zero, 7

expect v0 7
expect_pc 0x08800018
